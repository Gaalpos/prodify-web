---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CLOUD } from '../data/site';
import { langOf, lp, tr } from '../i18n';

const lang = langOf(Astro.url.pathname);
const t = tr(lang);
// The values sent to the server stay in English, so the board reads the same in both languages.
const sectionNames = ['Home', 'Notes', 'Journal', 'Tasks', 'Projects', 'Habits', 'Hobbies', 'Skills', 'Health', 'Collections', 'Calendar', 'Insights', 'Achievements', 'Storage', 'Music', 'Settings', 'Prodify Cloud / sync', 'Setup', 'Something else'];
const sectionEs: Record<string, string> = { Home: 'Inicio', Notes: 'Notas', Journal: 'Diario', Tasks: 'Tareas', Projects: 'Proyectos', Habits: 'Hábitos', Hobbies: 'Aficiones', Skills: 'Habilidades', Health: 'Salud', Collections: 'Colecciones', Calendar: 'Calendario', Insights: 'Estadísticas', Achievements: 'Logros', Storage: 'Almacenamiento', Music: 'Música', Settings: 'Ajustes', 'Prodify Cloud / sync': 'Prodify Cloud / sincronización', Setup: 'Configuración inicial', 'Something else': 'Otra cosa' };
const platforms = ['Linux', 'Windows', 'Android', 'Web app'];
const platformEs: Record<string, string> = { 'Web app': 'App web' };

// Each list asks the server for part of the board; the page fills them in.
const lists = [
  { id: 'ideas', title: t('Most-wanted ideas', 'Ideas más pedidas'), note: t('Open and planned ideas, most 👍 first.', 'Ideas abiertas y previstas, las de más 👍 primero.'), q: 'kind=idea&status=open,planned&sort=votes', empty: t('No ideas yet. Yours could be the first.', 'Aún no hay ideas. La tuya puede ser la primera.'), vote: true },
  { id: 'bugs', title: t('Known bugs', 'Fallos conocidos'), note: t('Open reports, newest first.', 'Informes abiertos, los más nuevos primero.'), q: 'kind=bug&status=open,planned&sort=new', empty: t('No open bug reports right now.', 'Ahora mismo no hay fallos abiertos.'), vote: true },
  { id: 'done', title: t('Recently shipped', 'Recién publicado'), note: t('Ideas and fixes that made it in.', 'Ideas y arreglos que ya están en la app.'), q: 'status=done&sort=new', empty: t('Nothing shipped from the board yet.', 'Aún no se ha publicado nada del tablón.'), vote: false },
];
// Text the page's script shows.
const msg = {
  bug: t('Bug', 'Fallo'), idea: t('Idea', 'Idea'), planned: t('Planned', 'Previsto'), today: t('today', 'hoy'), yesterday: t('yesterday', 'ayer'),
  daysAgo: t('{n} days ago', 'hace {n} días'), vote: t('Vote for this ({n} votes)', 'Votar ({n} votos)'),
  loadErr: t('Couldn’t load this list right now. Please try again later.', 'No se ha podido cargar esta lista. Inténtalo más tarde.'),
  sending: t('Sending…', 'Enviando…'), sentBug: t('Thanks! Your report was sent.', '¡Gracias! Tu informe se ha enviado.'), sentIdea: t('Thanks! Your idea is on the board.', '¡Gracias! Tu idea ya está en el tablón.'),
  wrong: t('Something went wrong', 'Algo ha fallado'), offline: t('Couldn’t reach the server. Check your connection and try again.', 'No se ha podido conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.'),
  locale: t('en-US', 'es-ES'),
};
---

<Base title={t('Feedback · Prodify', 'Opiniones · Prodify')} description={t('Report a bug or request a feature for Prodify, and vote for the ideas you want most.', 'Informa de un fallo o pide una función para Prodify, y vota las ideas que más quieres.')}>
  <Header />
  <main class="wrap page" data-cloud={CLOUD} data-msg={JSON.stringify(msg)}>
    <p class="eyebrow">{t('Feedback', 'Opiniones')}</p>
    <h1>{t('Help shape Prodify', 'Ayuda a dar forma a Prodify')}</h1>
    <p class="lead">{t("Found something broken, or missing something you'd use every day? Tell us. Every report and idea is read, and the ideas with the most 👍 are looked at first.", '¿Algo no funciona, o echas de menos algo que usarías cada día? Cuéntanoslo. Leemos cada informe e idea, y las ideas con más 👍 se miran primero.')}</p>

    <div class="grid">
      <form class="form" id="form" novalidate>
        <div class="kinds" role="radiogroup" aria-label={t('What would you like to send?', '¿Qué quieres enviar?')}>
          <label id="bug"><input type="radio" name="kind" value="bug" /><span><span class="dot" style="background:#d4605a"></span>{t('Report a bug', 'Informar de un fallo')}</span></label>
          <label id="feature"><input type="radio" name="kind" value="idea" checked /><span><span class="dot" style="background:#5fa57f"></span>{t('Request a feature', 'Pedir una función')}</span></label>
        </div>

        <label class="f">
          <span class="l">{t('Title', 'Título')}</span>
          <input name="title" maxlength="140" required autocomplete="off" />
        </label>
        <label class="f">
          <span class="l" data-bug={t('What happened, and how can we make it happen again?', '¿Qué ha pasado y cómo podemos repetirlo?')} data-idea={t('What would you like to do, and how could it work?', '¿Qué te gustaría hacer y cómo podría funcionar?')}>{t('What would you like to do, and how could it work?', '¿Qué te gustaría hacer y cómo podría funcionar?')}</span>
          <textarea name="body" rows="6" maxlength="5000" required></textarea>
        </label>

        <fieldset class="f">
          <legend class="l">{t('Where do you use Prodify?', '¿Dónde usas Prodify?')}</legend>
          <div class="checks">
            {platforms.map((p) => <label><input type="checkbox" name="platform" value={p} />{lang === 'es' ? platformEs[p] ?? p : p}</label>)}
          </div>
        </fieldset>

        <div class="row2">
          <label class="f">
            <span class="l">{t('Section', 'Sección')}</span>
            <select name="section">
              <option value="">{t('Choose…', 'Elegir…')}</option>
              {sectionNames.map((s) => <option value={s}>{lang === 'es' ? sectionEs[s] : s}</option>)}
            </select>
          </label>
          <label class="f">
            <span class="l">{t('Version', 'Versión')} <em>{t('(bottom of Settings)', '(al final de Ajustes)')}</em></span>
            <input name="version" maxlength="20" placeholder="1.18.3" autocomplete="off" />
          </label>
        </div>

        <label class="f">
          <span class="l">Email <em>{t("(optional, only if you'd like a reply; never shown)", '(opcional, solo si quieres respuesta; nunca se muestra)')}</em></span>
          <input name="email" type="email" maxlength="254" autocomplete="email" />
        </label>
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>

        <p class="fine">{t('Titles and descriptions are shown on this page so others can vote. Please leave out private notes, passwords and recovery keys.', 'Los títulos y descripciones se muestran en esta página para que otras personas puedan votar. No incluyas notas privadas, contraseñas ni claves de recuperación.')}</p>
        <div class="send">
          <button class="btn primary" type="submit">{t('Send', 'Enviar')}</button>
          <p class="status" role="status" aria-live="polite"></p>
        </div>
      </form>

      <div class="lists">
        {lists.map((l) => (
          <section class="list" data-q={l.q} data-empty={l.empty} data-vote={l.vote ? '1' : ''} aria-labelledby={`h-${l.id}`}>
            <h2 id={`h-${l.id}`}>{l.title}</h2>
            <p class="note">{l.note}</p>
            <ul aria-live="polite"><li class="msg">{t('Loading…', 'Cargando…')}</li></ul>
          </section>
        ))}
        {lang === 'es'
          ? <p class="fine">¿Tienes una pregunta? Puede que las <a href={lp(lang, 'docs/faq/')}>preguntas frecuentes</a> ya la respondan.</p>
          : <p class="fine">Have a question instead? The <a href={lp(lang, 'docs/faq/')}>FAQ</a> may already answer it.</p>}
      </div>
    </div>
  </main>
  <Footer />
</Base>

<script>
  const main = document.querySelector<HTMLElement>('main')!;
  const CLOUD = main.dataset.cloud!;
  const M = JSON.parse(main.dataset.msg!) as Record<string, string>;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const ago = (t: number) => {
    const d = Math.round((Date.now() - t) / 864e5);
    return d < 1 ? M.today : d === 1 ? M.yesterday : d < 30 ? M.daysAgo.replace('{n}', String(d)) : new Date(t).toLocaleDateString(M.locale, { month: 'short', day: 'numeric', year: 'numeric' });
  };
  // Which items this browser has voted for, so the buttons show it (the server counts one vote per person).
  const voted = new Set<number>((() => { try { return JSON.parse(localStorage.getItem('prodify.votes') || '[]') } catch { return [] } })());
  const saveVotes = () => { try { localStorage.setItem('prodify.votes', JSON.stringify([...voted])) } catch {} };
  interface Item { id: number; kind: string; title: string; body: string; status: string; votes: number; updated: number; section: string }

  const row = (i: Item, canVote: boolean) => `<li data-id="${i.id}">
    <details><summary><b>${esc(i.title)}</b><span class="meta">#${i.id} · ${i.kind === 'bug' ? M.bug : M.idea}${i.status === 'planned' ? ` · <span class="planned">${M.planned}</span>` : ''}${i.section ? ' · ' + esc(i.section) : ''} · ${ago(i.updated)}</span></summary><p class="body">${esc(i.body)}</p></details>
    ${canVote ? `<button class="vote${voted.has(i.id) ? ' on' : ''}" type="button" aria-pressed="${voted.has(i.id)}" aria-label="${M.vote.replace('{n}', String(i.votes))}">👍 <span>${i.votes}</span></button>` : `<span class="vote static">👍 ${i.votes}</span>`}
  </li>`;

  // fresh skips the browser's short cache, so something just sent shows up straight away.
  function load(box: HTMLElement, fresh = false) {
    const ul = box.querySelector('ul')!;
    fetch(`${CLOUD}/feedback?${box.dataset.q}&limit=10`, fresh ? { cache: 'reload' } : {})
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d: { items: Item[] }) => {
        ul.innerHTML = d.items.length ? d.items.map((i) => row(i, !!box.dataset.vote)).join('') : `<li class="msg">${esc(box.dataset.empty!)}</li>`;
      })
      .catch(() => { ul.innerHTML = `<li class="msg">${esc(M.loadErr)}</li>`; });
  }
  const boxes = [...document.querySelectorAll<HTMLElement>('.list')];
  boxes.forEach((b) => load(b));

  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button.vote');
    if (!b) return;
    const id = +b.closest<HTMLElement>('li')!.dataset.id!;
    b.disabled = true;
    try {
      const r = await fetch(`${CLOUD}/feedback/${id}/vote`, { method: 'POST' });
      const d = await r.json();
      if (!r.ok) throw new Error(d.error);
      d.voted ? voted.add(id) : voted.delete(id); saveVotes();
      b.classList.toggle('on', d.voted); b.setAttribute('aria-pressed', String(d.voted)); b.querySelector('span')!.textContent = String(d.votes);
    } catch { /* leave it as it was */ }
    b.disabled = false;
  });

  // The form: a bug report or an idea. #bug and #feature links (from the app) pick the kind.
  const form = document.getElementById('form') as HTMLFormElement, status = form.querySelector<HTMLElement>('.status')!;
  const bodyLabel = form.querySelector<HTMLElement>('[data-bug]')!;
  const setKind = (k: string) => {
    form.querySelector<HTMLInputElement>(`input[name="kind"][value="${k}"]`)!.checked = true;
    bodyLabel.textContent = bodyLabel.dataset[k === 'bug' ? 'bug' : 'idea']!;
  };
  if (location.hash === '#bug') setKind('bug');
  form.addEventListener('change', (e) => { const t = e.target as HTMLInputElement; if (t.name === 'kind') setKind(t.value); });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(form), btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const data = {
      kind: f.get('kind'), title: f.get('title'), body: f.get('body'), platform: f.getAll('platform').join(', '),
      section: f.get('section'), version: f.get('version'), email: f.get('email'), website: f.get('website'),
    };
    btn.disabled = true; status.className = 'status'; status.textContent = M.sending;
    try {
      const r = await fetch(`${CLOUD}/feedback`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || M.wrong);
      status.className = 'status ok';
      status.textContent = data.kind === 'bug' ? M.sentBug : M.sentIdea;
      const kind = String(data.kind);
      form.reset(); setKind(kind);
      boxes.forEach((b) => load(b, true));
    } catch (err) {
      status.className = 'status err';
      status.textContent = (err as Error).message === 'Failed to fetch' ? M.offline : (err as Error).message;
    }
    btn.disabled = false;
  });
</script>

<style>
  .page{padding-top:clamp(40px,6vw,72px);padding-bottom:72px}
  h1{font-size:clamp(36px,5vw,52px);margin-bottom:14px}
  .grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;margin-top:36px;align-items:start}

  .form{background:var(--sf);border:1px solid var(--line);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:16px}
  .kinds{display:grid;grid-template-columns:1fr 1fr;gap:8px;background:var(--bg);border-radius:12px;padding:4px}
  .kinds label{position:relative;cursor:pointer;scroll-margin-top:96px}
  .kinds input{position:absolute;opacity:0;pointer-events:none}
  .kinds label>span{display:flex;align-items:center;justify-content:center;gap:8px;padding:10px;border-radius:9px;font-weight:700;color:var(--mut)}
  .kinds input:checked+span{background:var(--sf);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.12)}
  .kinds input:focus-visible+span{outline:2px solid var(--ac);outline-offset:2px}
  .f{display:flex;flex-direction:column;gap:6px;border:0;padding:0;margin:0;min-width:0}
  .l{font-weight:700;font-size:15px;padding:0}
  .l em{font-style:normal;font-weight:400;color:var(--mut)}
  .f input,.f textarea,.f select{font:inherit;font-size:16px;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px;width:100%}
  .f textarea{resize:vertical;min-height:130px}
  .f input:focus,.f textarea:focus,.f select:focus{outline:2px solid var(--ac);outline-offset:1px;border-color:transparent}
  .checks{display:flex;flex-wrap:wrap;gap:8px 18px}
  .checks label{display:flex;align-items:center;gap:8px;cursor:pointer}
  .checks input{width:18px;height:18px;accent-color:var(--ac)}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
  .fine{color:var(--mut);font-size:14.5px}
  .send{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
  .send .btn:disabled{opacity:.6;cursor:default}
  .status{font-size:15px;color:var(--mut)}
  .status.ok{color:#3f8f63}
  .status.err{color:#c44a4a}

  .lists{display:flex;flex-direction:column;gap:16px}
  .list{background:var(--sf);border:1px solid var(--line);border-radius:16px;padding:20px}
  .list h2{font-size:22px}
  .note{color:var(--mut);font-size:14.5px;margin:4px 0 8px}
  .list ul{list-style:none;padding:0;margin:0}
  .list :global(li){display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-top:1px solid var(--line)}
  .list :global(li:first-child){border-top:0}
  .list :global(details){flex:1;min-width:0}
  .list :global(summary){list-style:none;cursor:pointer}
  .list :global(summary::-webkit-details-marker){display:none}
  .list :global(summary b){display:block;font-weight:600;font-size:15.5px;line-height:1.4}
  .list :global(summary:hover b){color:var(--ac)}
  .list :global(.meta){display:block;color:var(--mut);font-size:13px;margin-top:2px}
  .list :global(.planned){color:var(--ac);font-weight:700}
  .list :global(.body){margin:8px 0 2px;color:var(--mut);font-size:15px;white-space:pre-wrap;overflow-wrap:anywhere}
  .list :global(.vote){flex:none;font:inherit;font-size:13px;font-weight:700;color:var(--mut);background:var(--bg);border:1px solid var(--line);border-radius:999px;padding:3px 10px;cursor:pointer}
  .list :global(.vote:hover){border-color:var(--mut)}
  .list :global(.vote.on){color:var(--ac);border-color:var(--ac);background:var(--acs)}
  .list :global(.vote.static){cursor:default;border-color:transparent}
  .list :global(.msg){color:var(--mut);font-size:15px}

  @media (max-width:900px){.grid{grid-template-columns:1fr}}
  @media (max-width:480px){.row2{grid-template-columns:1fr}.form{padding:18px}.kinds{grid-template-columns:1fr}}
</style>
