---
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GROUPS } from '../content.config';

interface Props {
  title: string;
  description: string;
  current: string; // doc id, 'faq' or 'index'
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, current, headings = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={`${title} · Prodify docs`} description={description}>
  <Header />
  <div class="wrap docs">
    <aside class="side" aria-label="Docs">
      <details class="navbox" open>
        <summary>Docs menu</summary>
        <a class:list={['top', { on: current === 'index' }]} href={`${base}docs/`}>Overview</a>
        {GROUPS.map((g) => (
          <div class="grp">
            <p>{g}</p>
            {docs.filter((d) => d.data.group === g).map((d) => (
              <a class:list={{ on: current === d.id }} href={`${base}docs/${d.id}/`} aria-current={current === d.id ? 'page' : undefined}>
                {d.data.color && <span class="dot" style={`background:${d.data.color}`}></span>}
                {d.data.title}
              </a>
            ))}
          </div>
        ))}
        <div class="grp">
          <p>Help</p>
          <a class:list={{ on: current === 'faq' }} href={`${base}docs/faq/`} aria-current={current === 'faq' ? 'page' : undefined}>FAQ</a>
        </div>
      </details>
    </aside>

    <main class="body">
      <article class="prose">
        <slot />
      </article>
    </main>

    {toc.length > 1 && (
      <nav class="toc" aria-label="On this page">
        <p>On this page</p>
        {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    )}
  </div>
  <Footer />
</Base>

<script>
  // On narrow screens the docs menu starts closed so the page content comes first.
  if (matchMedia('(max-width: 860px)').matches) document.querySelector('.navbox')?.removeAttribute('open');
</script>

<style>
  .docs{display:grid;grid-template-columns:220px minmax(0,1fr) 190px;gap:clamp(24px,4vw,48px);padding-top:36px;padding-bottom:72px;align-items:start}
  .side,.toc{position:sticky;top:88px;max-height:calc(100vh - 104px);overflow:auto}
  .navbox summary{display:none}
  .side a{display:flex;align-items:center;gap:9px;padding:6px 10px;border-radius:8px;color:var(--mut);text-decoration:none;font-weight:500;font-size:15px}
  .side a:hover{color:var(--ink);background:var(--acs)}
  .side a.on{color:var(--ink);background:var(--acs);font-weight:700}
  .side .dot{width:8px;height:8px}
  .side a.top{margin-bottom:8px}
  .grp{margin-bottom:16px}
  .grp p{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin:0 0 4px 10px}
  .toc p{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);margin-bottom:8px}
  .toc a{display:block;color:var(--mut);text-decoration:none;font-size:14px;padding:4px 0}
  .toc a:hover{color:var(--ac)}
  .body{min-width:0}

  .prose{max-width:720px}
  .prose :global(h1){font-size:clamp(32px,4vw,42px);margin-bottom:12px}
  .prose :global(h2){font-size:26px;margin:44px 0 12px;scroll-margin-top:88px}
  .prose :global(h3){font:700 18px Figtree,sans-serif;letter-spacing:0;margin:28px 0 8px;scroll-margin-top:88px}
  .prose :global(p),.prose :global(ul),.prose :global(ol){margin:0 0 14px}
  .prose :global(li){margin:4px 0}
  .prose :global(.lead){color:var(--mut);font-size:19px;margin-bottom:28px}
  .prose :global(code){font:13.5px ui-monospace,"JetBrains Mono",monospace;background:var(--acs);padding:1px 6px;border-radius:5px}
  .prose :global(pre){background:var(--sf)!important;border:1px solid var(--line);border-radius:10px;padding:14px 16px;overflow-x:auto;margin:0 0 16px}
  .prose :global(pre code){background:none;padding:0;color:var(--ink)}
  .prose :global(kbd){font:600 12.5px ui-monospace,"JetBrains Mono",monospace;background:var(--sf);border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:1px 6px}
  .prose :global(table){width:100%;border-collapse:collapse;margin:0 0 18px;font-size:15px;display:block;overflow-x:auto}
  .prose :global(th),.prose :global(td){text-align:left;padding:8px 12px 8px 0;border-bottom:1px solid var(--line);vertical-align:top}
  .prose :global(th){font-weight:700}
  .prose :global(blockquote){margin:0 0 16px;padding:12px 16px;background:var(--acs);border-radius:10px}
  .prose :global(blockquote p:last-child){margin:0}
  .prose :global(img){border-radius:12px;border:1px solid var(--line)}

  @media (max-width:1100px){.docs{grid-template-columns:220px minmax(0,1fr)}.toc{display:none}}
  @media (max-width:860px){
    .docs{grid-template-columns:1fr;padding-top:20px}
    .side{position:static;max-height:none}
    .navbox{border:1px solid var(--line);border-radius:12px;background:var(--sf);padding:6px}
    .navbox summary{display:block;cursor:pointer;font-weight:700;padding:8px 10px}
    .navbox[open] summary{margin-bottom:6px}
  }
</style>
