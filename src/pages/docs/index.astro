---
import { getCollection } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { GROUPS } from '../../content.config';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<Docs title="Documentation" description="Guides for installing Prodify, using every section, and understanding where your data lives." current="index">
  <h1>Prodify docs</h1>
  <p class="lead">Install Prodify, learn what each section can do, and see exactly how your data is stored.</p>

  {GROUPS.map((g) => (
    <section class="grp">
      <h2>{g}</h2>
      <div class="cards">
        {docs.filter((d) => d.data.group === g).map((d) => (
          <a class="card" href={`${base}docs/${d.id}/`}>
            <b>{d.data.color && <span class="dot" style={`background:${d.data.color}`}></span>}{d.data.title}</b>
            <span>{d.data.description}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="grp">
    <h2>Help</h2>
    <div class="cards">
      <a class="card" href={`${base}docs/faq/`}>
        <b>FAQ</b>
        <span>Quick answers about pricing, platforms, your data, privacy, sync and installing.</span>
      </a>
      <a class="card" href="https://github.com/Gaalpos/prodify/issues">
        <b>Report a problem</b>
        <span>Found a bug or missing something? Open an issue on GitHub.</span>
      </a>
    </div>
  </section>
</Docs>

<style>
  .grp h2{font-size:22px;margin:36px 0 14px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
  .card{display:flex;flex-direction:column;gap:6px;padding:16px 18px;background:var(--sf);border:1px solid var(--line);border-radius:12px;color:var(--ink);text-decoration:none}
  .card:hover{border-color:var(--ac)}
  .card b{display:flex;align-items:center;gap:8px}
  .card .dot{width:8px;height:8px}
  .card span{color:var(--mut);font-size:14.5px;line-height:1.5}
</style>
