---
import { APP_URL, LOGIN_URL } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname;
const inDocs = path.startsWith(`${base}docs`);
---

<header class="hdr">
  <div class="wrap bar">
    <a class="brand" href={base} aria-label="Prodify home">
      <img src={`${base}favicon.svg`} alt="" width="30" height="30" />
      <span>Prodify</span>
    </a>
    <nav aria-label="Main">
      <a href={`${base}#sections`} class="hide-sm">Sections</a>
      <a href={`${base}#privacy`} class="hide-sm">Privacy</a>
      <a href={`${base}docs/`} class="hide-xs" aria-current={inDocs ? 'page' : undefined}>Docs</a>
      <a href={`${base}feedback/`} class="hide-sm" aria-current={path.startsWith(`${base}feedback`) ? 'page' : undefined}>Feedback</a>
      <a href={APP_URL} class="web">Try web app</a>
      <a href={LOGIN_URL} class="login">Log in</a>
      <a href={`${base}#download`} class="cta">Download</a>
    </nav>
  </div>
</header>

<style>
  .hdr{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 86%,transparent);backdrop-filter:saturate(1.4) blur(12px);-webkit-backdrop-filter:saturate(1.4) blur(12px);border-bottom:1px solid var(--line)}
  .bar{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
  .brand{display:flex;align-items:center;gap:10px;color:var(--ink);text-decoration:none;font:700 22px var(--font);letter-spacing:-.01em}
  nav{display:flex;align-items:center;gap:2px}
  nav a{color:var(--mut);text-decoration:none;font-weight:500;padding:8px 12px;border-radius:8px}
  nav a:hover,nav a[aria-current="page"]{color:var(--ink);background:var(--acs)}
  nav a.cta{color:var(--onac);background:var(--ac);font-weight:700;margin-left:6px}
  nav a.cta:hover{background:color-mix(in srgb,var(--ac) 88%,var(--ink))}
  nav a.web{color:var(--ac);font-weight:700}
  nav a.login{color:var(--ink);font-weight:700;border:1px solid var(--line);margin-left:4px}
  nav a.login:hover{border-color:var(--mut);background:var(--sf)}
  @media (max-width:820px){nav .hide-sm{display:none}}
  @media (max-width:560px){nav a.web{display:none}}
  @media (max-width:440px){nav .hide-xs{display:none}}
</style>
