---
import { APP_URL, LOGIN_URL } from '../data/site';
import { base, langOf, lp, tr } from '../i18n';
const lang = langOf(Astro.url.pathname);
const t = tr(lang);
---

<footer>
  <div class="wrap foot">
    <div class="col">
      <span class="fb"><img src={`${base}favicon.svg`} alt="" width="22" height="22" /> Prodify</span>
      <span class="meta">{t('Notes, journal, tasks and habits in plain Markdown.', 'Notas, diario, tareas y hábitos en Markdown.')}</span>
    </div>
    <nav class="links" aria-label={t('Footer', 'Pie de página')}>
      <a href={lp(lang, 'docs/')}>{t('Docs', 'Guías')}</a>
      <a href={lp(lang, 'docs/faq/')}>{t('FAQ', 'Preguntas')}</a>
      <a href={APP_URL}>{t('Try web app', 'Probar la web')}</a>
      <a href={LOGIN_URL}>{t('Log in', 'Entrar')}</a>
      <a href={lp(lang, 'feedback/')}>{t('Feedback', 'Opiniones')}</a>
      <a href={`${lp(lang)}#download`}>{t('Download', 'Descargar')}</a>
    </nav>
    {lang === 'es' ? (
      <p class="credits">
        Datos de ejercicios de <a href="https://github.com/yuhonas/free-exercise-db">free-exercise-db</a> y <a href="https://wger.de">wger</a>.
        Radio de <a href="https://somafm.com">SomaFM</a>, sonidos ambientales de <a href="https://freesound.org">Freesound</a>.
        Usa la API de TMDB, pero TMDB no lo respalda ni lo certifica. Fuente: JetBrains Mono (OFL).
      </p>
    ) : (
      <p class="credits">
        Exercise data from <a href="https://github.com/yuhonas/free-exercise-db">free-exercise-db</a> and <a href="https://wger.de">wger</a>.
        Radio by <a href="https://somafm.com">SomaFM</a>, ambient sounds from <a href="https://freesound.org">Freesound</a>.
        Uses the TMDB API but is not endorsed or certified by TMDB. Font: JetBrains Mono (OFL).
      </p>
    )}
  </div>
</footer>

<style>
  footer{border-top:1px solid var(--line);padding:32px 0 44px;margin-top:auto}
  .foot{display:grid;grid-template-columns:auto 1fr;gap:16px 32px;align-items:start}
  .col{display:flex;flex-direction:column;gap:4px}
  .fb{display:flex;align-items:center;gap:8px;font:700 17px var(--font)}
  .meta{color:var(--mut);font-size:14px}
  .links{display:flex;flex-wrap:wrap;gap:4px 18px;justify-content:flex-end}
  .links a{color:var(--ink);text-decoration:none;font-weight:500}
  .links a:hover{color:var(--ac)}
  .credits{grid-column:1/-1;color:var(--mut);font-size:13.5px;max-width:760px}
  .credits a{color:inherit}
  @media (max-width:640px){.foot{grid-template-columns:1fr}.links{justify-content:flex-start}}
</style>
