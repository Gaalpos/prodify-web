---
// A real Prodify screenshot that follows the visitor's light or dark setting.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  shot: string;
  alt: string;
  full?: boolean; // the 1440×900 window instead of the compact 960×720 one
  sizes?: string;
  eager?: boolean;
}

const { shot, alt, full = false, sizes = '(max-width: 900px) 100vw, 600px', eager = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/screens/*.webp', { eager: true });
const pick = (scheme: string) => files[`../assets/screens/${shot}-${scheme}${full ? '' : '-c'}.webp`].default;
const light = pick('light'), dark = pick('dark');
const widths = full ? [720, 1080, 1440, 2160, 2880] : [480, 720, 960, 1440, 1920];
const [l, d] = await Promise.all(
  [light, dark].map((src) => getImage({ src, widths, sizes, format: 'webp', quality: 82 })),
);
---

<picture class="screen">
  <source media="(prefers-color-scheme: dark)" srcset={d.srcSet.attribute} sizes={sizes} />
  <img
    src={l.src}
    srcset={l.srcSet.attribute}
    sizes={sizes}
    width={light.width / 2}
    height={light.height / 2}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>

<style>
  .screen{display:block}
  .screen img{display:block;width:100%;height:auto;border-radius:12px;border:1px solid var(--line);background:var(--sf)}
</style>
